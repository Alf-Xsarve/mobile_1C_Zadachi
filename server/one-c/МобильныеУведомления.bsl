// Серверный неглобальный общий модуль МобильныеУведомления.
// Подписки сгенерируйте для Задача.ТехЗаданияДляПрограммистов.
// Секрет заполните только в конфигурации на сервере.
Процедура ЗадачаПередЗаписью(Источник, Отказ) Экспорт
    Источник.ДополнительныеСвойства.Вставить("PushНоваяЗадача", Источник.ЭтоНовый());
КонецПроцедуры

Процедура ЗадачаПриЗаписи(Источник, Отказ) Экспорт
    НоваяЗадача = Ложь;
    Если Отказ Или Не Источник.ДополнительныеСвойства.Свойство("PushНоваяЗадача", НоваяЗадача) Тогда
        Возврат;
    КонецЕсли;
    Если Не НоваяЗадача Тогда Возврат; КонецЕсли;
    Параметры = Новый Массив;
    Параметры.Добавить(Строка(Источник.Ссылка.УникальныйИдентификатор()));
    ФоновыеЗадания.Выполнить("МобильныеУведомления.ОтправитьНовуюЗадачу", Параметры);
КонецПроцедуры

Процедура ОтправитьНовуюЗадачу(ИдентификаторЗадачи) Экспорт
    КлючИнтеграции = "ЗАПОЛНИТЕ_КЛЮЧОМ_С_СЕРВЕРА";
    АдресБазы = "https://ВАШ-СЕРВЕР/Neichural_agro/odata/standard.odata/";
    Данные = Новый Структура("taskId,source", ИдентификаторЗадачи, АдресБазы);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();
    Соединение = Новый HTTPСоединение("alf-mobile-tasks.duckdns.org", 443, , , , 10, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/api/integrations/1c/new-task");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("X-OneC-Key", КлючИнтеграции);
    Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "API уведомлений вернул HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
КонецПроцедуры
